<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime (needed for notarization) blocks Apple Events unless the app
	     asks for them here. Switchboard uses them for System Events and Finder.
	     Bluetooth needs no entitlement outside the App Sandbox. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
